# This repo tracks only Omarchy-related config (hypr + omarchy) out of the
# broader ~/.config tree. Everything else is ignored by default.
/*
!/.gitignore
!/README.md
!/KEYBINDINGS.md
!/hypr/
!/omarchy/
!/systemd/
systemd/user/*
!systemd/user/random-wallpaper.service
!systemd/user/random-wallpaper.timer
