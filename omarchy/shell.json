{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "sonos",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/sonos-status.py",
          "interval": 5,
          "onClick": "~/.config/omarchy/bar/scripts/sonos-toggle.py"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "milesj.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "milesj.powermenu"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 1805,
    "screensaver": 1800
  },
  "plugins": [],
  "version": 1
}
