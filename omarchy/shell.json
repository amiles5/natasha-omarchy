{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "milesj.workspaces"
        }
      ],
      "right": [
        {
          "id": "ozz1ee.bardock",
          "docked": [
            {
              "id": "omarchy.agents",
              "dockedBy": "ozz1ee.bardock"
            },
            {
              "id": "omarchy.tailscale",
              "dockedBy": "ozz1ee.bardock"
            },
            {
              "id": "omarchy.bluetooth",
              "dockedBy": "ozz1ee.bardock"
            },
            {
              "id": "io.github.endijs.t2-fan-control",
              "dockedBy": "ozz1ee.bardock"
            },
            {
              "id": "milesj.monitor",
              "dockedBy": "ozz1ee.bardock"
            },
            {
              "id": "omarchy.keyboard-layout",
              "dockedBy": "ozz1ee.bardock"
            }
          ],
          "dockHomes": {
            "omarchy.agents": {
              "section": "right",
              "before": "omarchy.bluetooth"
            },
            "omarchy.tailscale": {
              "section": "right",
              "before": "omarchy.bluetooth"
            },
            "omarchy.bluetooth": {
              "section": "right",
              "before": "logitech-battery"
            },
            "io.github.endijs.t2-fan-control": {
              "section": "right",
              "before": "logitech-battery"
            },
            "milesj.monitor": {
              "section": "right",
              "before": "omarchy.power"
            },
            "omarchy.keyboard-layout": {
              "section": "center",
              "before": "omarchy.weather"
            }
          }
        },
        {
          "id": "logitech-battery",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/logitech-battery.py",
          "interval": 120,
          "onClick": "solaar"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "sonos",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/sonos-status.py",
          "interval": 5,
          "onClick": "~/.config/omarchy/bar/scripts/sonos-toggle.py"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "milesj.powermenu"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 1805,
    "screensaver": 1800
  },
  "plugins": [
    {
      "id": "omarchy.agents",
      "dockedBy": "ozz1ee.bardock"
    },
    {
      "id": "omarchy.tailscale",
      "dockedBy": "ozz1ee.bardock"
    },
    {
      "id": "omarchy.bluetooth",
      "dockedBy": "ozz1ee.bardock"
    },
    {
      "id": "io.github.endijs.t2-fan-control",
      "dockedBy": "ozz1ee.bardock"
    },
    {
      "id": "milesj.monitor",
      "dockedBy": "ozz1ee.bardock"
    },
    {
      "id": "omarchy.keyboard-layout",
      "dockedBy": "ozz1ee.bardock"
    }
  ],
  "version": 1
}
