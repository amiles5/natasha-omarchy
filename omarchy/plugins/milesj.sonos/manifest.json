{
  "schemaVersion": 1,
  "id": "milesj.sonos",
  "name": "Sonos",
  "version": "1.0.0",
  "author": "milesj",
  "license": "MIT",
  "description": "Play/pause and volume for local Sonos speakers via direct UPnP/SOAP control, auto-ducking when other host audio plays.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Sonos",
    "description": "Sonos playback control with auto-duck",
    "category": "Media",
    "allowMultiple": false
  }
}
